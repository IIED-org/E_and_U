{#
/**
 * @file
 * Theme override for a breadcrumb trail.
 *
 * Available variables:
 * - breadcrumb: Breadcrumb trail items.
 */
#}
{% if breadcrumb %}
  <nav role="navigation" aria-labelledby="system-breadcrumb">
    <h2 id="system-breadcrumb" class="visually-hidden">{{ 'Breadcrumb'|t }}</h2>
    <ol class="m-0 flex list-none flex-wrap items-center p-0 text-sm">
    {% for item in breadcrumb %}
      <li class="flex items-center">
        {% if not loop.first %}
          <span class="px-2 inline-block" aria-hidden="true">/</span>
        {% endif %}
        {% if item.url %}
          <a href="{{ item.url }}" class="text-inherit hover:underline">{{ item.text }}</a>
        {% else %}
          <span class="font-medium" aria-current="page">{{ item.text }}</span>
        {% endif %}
      </li>
    {% endfor %}
    </ol>
  </nav>
{% endif %}
