{#
/**
 * @file
  * Theme override to display a node of the journal issue (feature) content type.
 */
#}
<article{{ attributes.addClass('node') }}>

  {# {{ title_prefix }}
  {% if not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

  {% if display_submitted %}
    <footer>
      {{ author_picture }}
      <div{{ author_attributes }}>
        {% trans %}Submitted by {{ author_name }} on {{ date }}{% endtrans %}
        {{ metadata }}
      </div>
    </footer>
  {% endif %} #}

  {# <div{{ content_attributes.addClass('node-content') }}>
    {% include 'e_and_u_tw:prose-text' with { content: content } only %}
  </div> #}

<div class="flex items-start gap-6 mx-auto max-w-7xl md:gap-12 lg:gap-16">
<div class="w-1/3 md:w-1/4 lg:w-1/5 shrink-0">
         
                <div class="">
                    {{ content.field_featured_image }}
                </div>
            
        </div>
        <div class="flex-1">
          {{ title_prefix }}
  {% if not page %}
            <h2{{ title_attributes }} class="mb-4 text-2xl font-bold md:text-3xl md:mb-6">{{ label }}</h2>
  {% endif %}
              {{ title_suffix }}
            <div class="mb-4 prose prose-lg lg:prose-xl max-w-none">
                {{ content.field_standfirst }}
            </div>
            <div class="mb-4 prose prose-lg max-w-none">
                {{ content.body }}
            </div>
            <div class="flex items-center gap-2 font-semibold text-green-700">
                {{ content.field_link_to_sage }}
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
  <path fill-rule="evenodd" d="M5.22 14.78a.75.75 0 0 0 1.06 0l7.22-7.22v5.69a.75.75 0 0 0 1.5 0v-7.5a.75.75 0 0 0-.75-.75h-7.5a.75.75 0 0 0 0 1.5h5.69l-7.22 7.22a.75.75 0 0 0 0 1.06Z" clip-rule="evenodd" />
</svg>

            </div>
        </div>
</div>

</div>  

</article>
