{#
/**
 * @file
  * Theme override to display a card of the call out content type.
 */
#}
<article{{ attributes.addClass('node') }}>

  <section class="px-0 py-6 mx-0 my-4 overflow-hidden rounded-3xl bg-peach-200 sm:mx-2 md:mx-4">
    <div class="container mx-auto grid grid-cols-1 items-start gap-8 px-4 lg:grid-cols-[minmax(0,1fr)_auto] lg:items-center lg:gap-16">

      <div class="min-w-0">
        {{ title_prefix }}

        <h2{{ title_attributes.addClass('mt-4', 'mb-4', 'text-xl', 'font-bold', 'md:mb-6', 'md:text-2xl') }}>
          {{ label }}
        </h2>

        {{ title_suffix }}

        {% if content.field_call_out %}
          <div class="max-w-4xl mb-4 text-lg prose prose-lg lg:text-xl">
            {{ content.field_call_out }}
          </div>
        {% endif %}
      </div>

      {% if content.field_link %}
        <div class="inline-flex items-center gap-3 mb-4 text-lg prose prose-lg lg:justify-self-end lg:text-xl text-evergreen-700">
          {{ content.field_link }}
              <span class="inline-flex items-center justify-center border rounded-full border-evergreen-700 size-10 shrink-0" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="size-5">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
            </span>
        </div>
      {% endif %}

    </div>
  </section>

</article>

