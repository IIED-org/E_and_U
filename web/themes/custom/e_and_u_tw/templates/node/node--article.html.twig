{#
/**
 * @file
 * Theme override to display a node article content type.
 */ 

#}

{%
  set classes = [
    'node',
    'node--type-' ~ node.bundle|clean_class,
    node.isPromoted() ? 'node--promoted',
    node.isSticky() ? 'node--sticky',
    not node.isPublished() ? 'node--unpublished',
    view_mode ? 'node--view-mode-' ~ view_mode|clean_class,
    'container',
    'mx-auto',
    'px-4',
    'mb-12',
  ]
%}

<article{{ attributes.addClass(classes) }}>

  {{ title_prefix }}
  {% if not page %}
    <h2{{ title_attributes }}>
      <a href="{{ url }}" rel="bookmark">{{ label }}</a>
    </h2>
  {% endif %}
  {{ title_suffix }}

    <h1 class="max-w-4xl mx-auto mb-6 page-title lg:mb-12">{{ node.label }}</h1>


  <div{{ content_attributes.addClass('node-content') }}>
    {% include 'e_and_u_tw:prose-text' with { content: content } only %}
  </div>

</article>
